<Application
    x:Class="SoftPilot.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SoftPilotCardBackground" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SoftPilotSubtleText" Color="#475569" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SoftPilotCardBackground" Color="#172033" />
                    <SolidColorBrush x:Key="SoftPilotSubtleText" Color="#CBD5E1" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SoftPilotCardBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SoftPilotSubtleText" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
