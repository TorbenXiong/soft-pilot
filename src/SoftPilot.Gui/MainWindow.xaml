<Window
    x:Class="SoftPilot.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SoftPilot.Gui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SoftPilot">

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        FontFamily="Segoe UI Variable Text"
        FontSize="15"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <Style x:Key="RuntimeTableHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SoftPilotSubtleText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RuntimeTableCellTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RuntimeTableListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <SolidColorBrush x:Key="SoftPilotEnvironmentActiveBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="RedisStartBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="RedisStopBrush" Color="#C50F1F" />
            <Style x:Key="EnvironmentCheckAvailableStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="HoverSurface" Margin="4" CornerRadius="18"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                                <FontIcon x:Name="CheckGlyph" Glyph="&#xE73E;" FontSize="19"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverSurface.Opacity" Value="1" />
                                                <Setter Target="CheckGlyph.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverSurface.Opacity" Value="1" />
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="CheckGlyph.Opacity" Value="0.25" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EnvironmentCheckActiveStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="HoverSurface" Margin="4" CornerRadius="18"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                                <FontIcon Glyph="&#xE73E;" FontSize="20"
                                          Foreground="{StaticResource SoftPilotEnvironmentActiveBrush}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverSurface.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RuntimeSegmentButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="168" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SegmentSurface"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="SegmentContent"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentSurface.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentSurface.Opacity" Value="0.74" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentSurface.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentSurface.Background" Value="#1688F8" />
                                                <Setter Target="SegmentSurface.BorderBrush" Value="#1688F8" />
                                                <Setter Target="SegmentContent.Foreground" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StableHyperlinkButtonStyle" TargetType="controls:StableHyperlinkButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:StableHyperlinkButton">
                            <Border x:Name="LinkSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <controls:StableCursorContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.16" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LinkSurface.Opacity" Value="0.78" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LinkSurface.Opacity" Value="0.58" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LinkSurface.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RuntimeOperationButtonStyle"
                   TargetType="controls:StableHyperlinkButton"
                   BasedOn="{StaticResource StableHyperlinkButtonStyle}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="CellLinkOverlayStyle"
                   TargetType="controls:StableHyperlinkButton"
                   BasedOn="{StaticResource StableHyperlinkButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="controls:StableCursorButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:StableCursorButton">
                            <Border x:Name="IconSurface" CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="IconSurface.Background"
                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="IconSurface.Background"
                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="IconSurface.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CellValueButtonStyle" TargetType="controls:StableCursorButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:StableCursorButton">
                            <Border x:Name="ValueSurface" CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ValueSurface.Background"
                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ValueSurface.Background"
                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RedisServiceButtonStyle" TargetType="controls:StableCursorButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:StableCursorButton">
                            <Grid x:Name="ButtonRoot">
                                <controls:StableCursorContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.82" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ModuleCardItemStyle" TargetType="GridViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NodeNavigationItem" Content="Node.js" Tag="runtime:node"
                                Visibility="{x:Bind ViewModel.NodeModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Node.js module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/nodejs.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="JavaNavigationItem" Content="Java" Tag="runtime:java"
                                Visibility="{x:Bind ViewModel.JavaModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Java module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/java.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PythonNavigationItem" Content="Python" Tag="runtime:python"
                                Visibility="{x:Bind ViewModel.PythonModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Python module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/python.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RedisNavigationItem" Content="Redis" Tag="runtime:redis"
                                Visibility="{x:Bind ViewModel.RedisModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Redis module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/redis.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="MySqlNavigationItem" Content="MySQL" Tag="runtime:mysql"
                                Visibility="{x:Bind ViewModel.MySqlModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="MySQL module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/mysql.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="GitBashNavigationItem" Content="Git" Tag="git"
                                Visibility="{x:Bind ViewModel.GitModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Git module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/git.svg" Width="20" Height="20" Foreground="#F03C2E" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ToolboxNavigationItem"
                                Content="{x:Bind ViewModel.ToolboxText, Mode=OneWay}"
                                Tag="toolbox"
                                Visibility="{x:Bind ViewModel.ToolboxModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Toolbox module">
                <NavigationViewItem.Icon>
                    <ImageIcon Source="Assets/RuntimeIcons/toolbox.svg" Width="20" Height="20" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator x:Name="RuntimeNavigationSeparator" />
            <NavigationViewItem x:Name="TasksNavigationItem" Content="{x:Bind ViewModel.TaskHistoryText, Mode=OneWay}" Tag="tasks"
                                AutomationProperties.Name="Task history">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="{x:Bind ViewModel.SettingsText, Mode=OneWay}" Tag="settings"
                                AutomationProperties.Name="Settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Text="Node.js" Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <controls:StableCursorButton x:Name="PageRefreshButton" Grid.Column="1"
                                             Command="{x:Bind ViewModel.RefreshCommand}"
                                             Style="{StaticResource IconButtonStyle}"
                                             AutomationProperties.Name="Refresh current status"
                                             ToolTipService.ToolTip="{x:Bind ViewModel.RefreshText, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="18"
                                  Visibility="{x:Bind ViewModel.RefreshIconVisibility, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.RefreshProgressVisibility, Mode=OneWay}" />
                    </Grid>
                </controls:StableCursorButton>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="RuntimesView"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="8,8,8,16">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Spacing="0">
                                        <controls:StableCursorToggleButton x:Name="InstalledTabButton"
                                                                           Content="{x:Bind ViewModel.InstalledTabText, Mode=OneWay}"
                                                                           Style="{StaticResource RuntimeSegmentButtonStyle}"
                                                                           CornerRadius="8,0,0,0"
                                                                           IsChecked="True"
                                                                           Click="OnInstalledTabClick" />
                                        <controls:StableCursorToggleButton x:Name="VersionManagementTabButton"
                                                                           Content="{x:Bind ViewModel.VersionManagementTabText, Mode=OneWay}"
                                                                           Style="{StaticResource RuntimeSegmentButtonStyle}"
                                                                           CornerRadius="0,8,0,0"
                                                                           Click="OnVersionManagementTabClick" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid x:Name="InstalledTabContent" Padding="8,8,8,0">
                                            <TextBlock Text="{x:Bind ViewModel.NoInstalledText, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.InstalledRuntimesEmptyVisibility, Mode=OneWay}"
                                                       Foreground="{ThemeResource SoftPilotSubtleText}"
                                                       HorizontalAlignment="Center" Margin="0,64" />
                                            <ListView ItemsSource="{x:Bind ViewModel.InstalledRuntimes}"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch"
                                                      ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}"
                                                      AutomationProperties.Name="Installed versions for the current runtime">
                                                <ListView.Header>
                                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="8" Height="48">
                                                        <Grid Padding="20,0" ColumnSpacing="24">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="135" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="{x:Bind ViewModel.PortColumnWidth, Mode=OneWay}" />
                                                                <ColumnDefinition Width="{x:Bind ViewModel.ServiceColumnWidth, Mode=OneWay}" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind ViewModel.VersionHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PathHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.EnvironmentHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.PortHeaderText, Mode=OneWay}"
                                                                       Visibility="{x:Bind ViewModel.PortColumnVisibility, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ServiceHeaderText, Mode=OneWay}"
                                                                       Visibility="{x:Bind ViewModel.ServiceColumnVisibility, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.OperationHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </ListView.Header>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid Padding="20,0" ColumnSpacing="24" MinHeight="60">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="135" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="{Binding PortColumnWidth}" />
                                                                    <ColumnDefinition Width="{Binding ServiceColumnWidth}" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayVersion}"
                                                                               ToolTipService.ToolTip="{Binding VersionToolTip}"
                                                                               Style="{StaticResource RuntimeTableCellTextStyle}" />
                                                                    <controls:StableCursorButton Style="{StaticResource IconButtonStyle}"
                                                                                                 Width="32" Height="32" Padding="0"
                                                                                                 Visibility="{Binding CopyMySqlPasswordVisibility}"
                                                                                                 IsEnabled="{Binding CanCopyMySqlPassword}"
                                                                                                 Click="OnCopyMySqlPasswordClick"
                                                                                                 ToolTipService.ToolTip="{Binding CopyMySqlPasswordToolTip}"
                                                                                                 AutomationProperties.Name="{Binding CopyMySqlPasswordToolTip}">
                                                                        <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                                                    </controls:StableCursorButton>
                                                                </StackPanel>
                                                                <Grid Grid.Column="1" ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Path}"
                                                                               Style="{StaticResource RuntimeTableCellTextStyle}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               IsHitTestVisible="False" />
                                                                    <controls:StableHyperlinkButton
                                                                        Style="{StaticResource CellLinkOverlayStyle}"
                                                                        Canvas.ZIndex="1"
                                                                        Click="OnOpenInstalledPathClick"
                                                                        ToolTipService.ToolTip="{Binding Path}"
                                                                        AutomationProperties.Name="Open installation directory" />
                                                                    <controls:StableCursorButton Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                                                                 Width="36" Height="36"
                                                                                                 Click="OnCopyInstalledPathClick"
                                                                                                 ToolTipService.ToolTip="{Binding CopyPathToolTip}"
                                                                                                 AutomationProperties.Name="Copy installation path">
                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                                    </controls:StableCursorButton>
                                                                </Grid>
                                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" Spacing="4">
                                                                    <Grid HorizontalAlignment="Center">
                                                                        <controls:StableCursorButton Style="{StaticResource EnvironmentCheckAvailableStyle}"
                                                                                                     Visibility="{Binding SetEnvironmentVisibility}"
                                                                                                     Click="OnInstalledEnvironmentClick"
                                                                                                     ToolTipService.ToolTip="{Binding EnvironmentActionToolTip}"
                                                                                                     AutomationProperties.Name="{Binding EnvironmentActionName}" />
                                                                        <controls:StableCursorButton Style="{StaticResource EnvironmentCheckActiveStyle}"
                                                                                                     Visibility="{Binding ClearEnvironmentVisibility}"
                                                                                                     Click="OnInstalledEnvironmentClick"
                                                                                                     ToolTipService.ToolTip="{Binding EnvironmentActionToolTip}"
                                                                                                     AutomationProperties.Name="{Binding EnvironmentActionName}" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding OperationStatusText}"
                                                                               Visibility="{Binding EnvironmentFeedbackVisibility}"
                                                                               Foreground="{Binding OperationStatusBrush}"
                                                                               FontSize="13" TextWrapping="Wrap"
                                                                               TextAlignment="Center" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Visibility="{Binding PortColumnVisibility}">
                                                                    <TextBlock Text="{Binding PortText}" VerticalAlignment="Center"
                                                                               Visibility="{Binding FixedPortVisibility}" />
                                                                    <TextBox Text="{Binding PortText, Mode=TwoWay}"
                                                                             Width="66" Height="34" Padding="8,4"
                                                                             HorizontalContentAlignment="Center"
                                                                             IsEnabled="{Binding CanEditPort}"
                                                                             Visibility="{Binding MySqlPortEditorVisibility}"
                                                                             AutomationProperties.Name="MySQL port" />
                                                                    <controls:StableCursorButton Width="34" Height="34" Padding="0"
                                                                                                 Style="{StaticResource IconButtonStyle}"
                                                                                                 IsEnabled="{Binding CanSavePort}"
                                                                                                 Visibility="{Binding MySqlPortEditorVisibility}"
                                                                                                 Click="OnSaveMySqlPortClick"
                                                                                                 ToolTipService.ToolTip="{Binding SavePortText}"
                                                                                                 AutomationProperties.Name="{Binding SavePortText}">
                                                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                                    </controls:StableCursorButton>
                                                                </StackPanel>
                                                                <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Visibility="{Binding ServiceColumnVisibility}">
                                                                    <controls:StableCursorButton Style="{StaticResource RedisServiceButtonStyle}"
                                                                                                 Visibility="{Binding StartServiceVisibility}"
                                                                                                 IsEnabled="{Binding IsServiceActionEnabled}"
                                                                                                 Click="OnStartInstalledServiceClick"
                                                                                                 ToolTipService.ToolTip="{Binding StartServiceToolTip}"
                                                                                                 AutomationProperties.Name="{Binding StartServiceToolTip}">
                                                                        <Path Width="29" Height="32"
                                                                              Data="M 2,1 L 28,16 L 2,31 Z"
                                                                              Stretch="Fill"
                                                                              Fill="{StaticResource RedisStartBrush}" />
                                                                    </controls:StableCursorButton>
                                                                    <controls:StableCursorButton Style="{StaticResource RedisServiceButtonStyle}"
                                                                                                 Visibility="{Binding StopServiceVisibility}"
                                                                                                 IsEnabled="{Binding IsServiceActionEnabled}"
                                                                                                 Click="OnStopInstalledServiceClick"
                                                                                                 ToolTipService.ToolTip="{Binding StopServiceToolTip}"
                                                                                                 AutomationProperties.Name="{Binding StopServiceToolTip}">
                                                                        <Grid Width="34" Height="34">
                                                                            <Ellipse Fill="{StaticResource RedisStopBrush}" />
                                                                            <FontIcon Glyph="&#xE7E8;" FontSize="22" Foreground="White" />
                                                                        </Grid>
                                                                    </controls:StableCursorButton>
                                                                    <ProgressRing Width="22" Height="22" IsActive="True"
                                                                                  Visibility="{Binding ServiceProgressVisibility}" />
                                                                    <TextBlock Text="—" Foreground="{ThemeResource SoftPilotSubtleText}"
                                                                               Visibility="{Binding ServiceUnavailableVisibility}"
                                                                               ToolTipService.ToolTip="{Binding ServiceUnavailableToolTip}" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <controls:StableHyperlinkButton Content="{Binding UninstallText}"
                                                                                                    Style="{StaticResource RuntimeOperationButtonStyle}"
                                                                                                    Visibility="{Binding UninstallVisibility}"
                                                                                                    Click="OnUninstallInstalledClick" />
                                                                    <TextBlock Text="{Binding OperationStatusText}"
                                                                               Visibility="{Binding OperationFeedbackVisibility}"
                                                                               Foreground="{Binding OperationStatusBrush}"
                                                                               FontSize="13" TextWrapping="Wrap"
                                                                               HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                        <Grid x:Name="VersionManagementTabContent" Padding="8,8,8,0" Visibility="Collapsed">
                                            <StackPanel Visibility="{x:Bind ViewModel.CatalogLoadingVisibility, Mode=OneWay}"
                                                        HorizontalAlignment="Center" Margin="0,64" Spacing="12"
                                                        Canvas.ZIndex="1">
                                                <ProgressRing IsActive="True" Width="28" Height="28" />
                                                <TextBlock Text="{x:Bind ViewModel.CatalogLoadingText, Mode=OneWay}"
                                                           Foreground="{ThemeResource SoftPilotSubtleText}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.NoVersionsText, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.VersionRowsEmptyVisibility, Mode=OneWay}"
                                                       Foreground="{ThemeResource SoftPilotSubtleText}"
                                                       HorizontalAlignment="Center" Margin="0,64" />
                                            <ListView ItemsSource="{x:Bind ViewModel.VersionRows}"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch"
                                                      ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}"
                                                      AutomationProperties.Name="Version management list for the current runtime">
                                                <ListView.Header>
                                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="8" Height="48">
                                                        <Grid Padding="20,0" ColumnSpacing="24">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="145" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="140" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind ViewModel.ReleaseLineHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.VersionHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.IsInstalledHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.OperationHeaderText, Mode=OneWay}"
                                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                                       HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </ListView.Header>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid Padding="20,0" ColumnSpacing="24" MinHeight="60">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="145" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="140" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid>
                                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                                VerticalAlignment="Center"
                                                                                IsHitTestVisible="False">
                                                                        <TextBlock Text="{Binding ReleaseLine}"
                                                                                   Style="{StaticResource RuntimeTableCellTextStyle}" />
                                                                        <ProgressBar Width="116" Height="4" Minimum="0" Maximum="100"
                                                                                     Value="{Binding OperationPercentage}"
                                                                                     Visibility="{Binding ProgressVisibility}"
                                                                                     AutomationProperties.Name="Installation progress" />
                                                                        <TextBlock Text="{Binding OperationStatusText}"
                                                                                   Visibility="{Binding FeedbackVisibility}"
                                                                                   Foreground="{Binding OperationStatusBrush}"
                                                                                   ToolTipService.ToolTip="{Binding OperationStatusText}"
                                                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="260" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <controls:StableHyperlinkButton
                                                                        Style="{StaticResource CellLinkOverlayStyle}"
                                                                        Canvas.ZIndex="1"
                                                                        Visibility="{Binding ReleasePageLinkVisibility}"
                                                                        Tag="{Binding ReleasePageUrl}"
                                                                        Click="OnOpenRuntimeUrlClick"
                                                                        ToolTipService.ToolTip="{Binding ReleasePageUrl}"
                                                                        AutomationProperties.Name="Open release-line download page" />
                                                                </Grid>
                                                                <Grid Grid.Column="1">
                                                                    <TextBlock Text="{Binding DisplayVersion}"
                                                                               Style="{StaticResource RuntimeTableCellTextStyle}"
                                                                               ToolTipService.ToolTip="{Binding VersionToolTip}"
                                                                               IsHitTestVisible="False" />
                                                                    <controls:StableHyperlinkButton
                                                                        Style="{StaticResource CellLinkOverlayStyle}"
                                                                        Canvas.ZIndex="1"
                                                                        Visibility="{Binding VersionLinkVisibility}"
                                                                        Tag="{Binding DownloadUrl}"
                                                                        Click="OnOpenRuntimeUrlClick"
                                                                        ToolTipService.ToolTip="{Binding DownloadUrl}"
                                                                        AutomationProperties.Name="Open version page" />
                                                                </Grid>
                                                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="18"
                                                                          Foreground="#0F9D58" HorizontalAlignment="Center"
                                                                          Visibility="{Binding InstalledVisibility}"
                                                                          AutomationProperties.Name="Installed" />
                                                                <Grid Grid.Column="3" HorizontalAlignment="Center">
                                                                    <controls:StableHyperlinkButton Content="{Binding InstallText}" Click="OnInstallVersionClick"
                                                                                                    Style="{StaticResource RuntimeOperationButtonStyle}"
                                                                                                    Visibility="{Binding InstallVisibility}" />
                                                                    <controls:StableHyperlinkButton Content="{Binding UninstallText}" Click="OnUninstallVersionClick"
                                                                                                    Style="{StaticResource RuntimeOperationButtonStyle}"
                                                                                                    Visibility="{Binding UninstallVisibility}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="GitBashView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="8,8,8,16">
                            <StackPanel Spacing="12">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8" Height="48">
                                    <Grid Padding="20,0" ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.GitBashInstalledVersionLabel, Mode=OneWay}"
                                                   Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="{x:Bind ViewModel.GitBashLatestVersionLabel, Mode=OneWay}"
                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                       IsHitTestVisible="False" />
                                            <controls:StableHyperlinkButton
                                                Style="{StaticResource CellLinkOverlayStyle}"
                                                Canvas.ZIndex="1"
                                                Tag="{x:Bind ViewModel.GitBashReleasePageUrl, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.GitBashReleasePageVisibility, Mode=OneWay}"
                                                Click="OnOpenGitBashReleaseClick"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.GitBashReleasePageUrl, Mode=OneWay}"
                                                AutomationProperties.Name="Open latest official Git for Windows release" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.GitBashInstallPathLabel, Mode=OneWay}"
                                                   Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.OperationHeaderText, Mode=OneWay}"
                                                   Style="{StaticResource RuntimeTableHeaderTextStyle}"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid Padding="20,0" ColumnSpacing="24" MinHeight="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.GitBashInstalledVersion, Mode=OneWay}"
                                                   Style="{StaticResource RuntimeTableCellTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GitBashLatestVersion, Mode=OneWay}"
                                                   Style="{StaticResource RuntimeTableCellTextStyle}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.GitBashDownloadUrl, Mode=OneWay}" />
                                        <Grid Grid.Column="2" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ViewModel.GitBashInstallPath}"
                                                       Style="{StaticResource RuntimeTableCellTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False" />
                                            <controls:StableHyperlinkButton
                                                Style="{StaticResource CellLinkOverlayStyle}"
                                                Canvas.ZIndex="1"
                                                Visibility="{x:Bind ViewModel.GitBashInstalledActionsVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanUseInstalledGitBash, Mode=OneWay}"
                                                Click="OnOpenGitBashFolderClick"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.GitBashInstallPath}"
                                                AutomationProperties.Name="Open Git installation directory" />
                                            <controls:StableCursorButton Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                                         Width="36" Height="36"
                                                                         Visibility="{x:Bind ViewModel.GitBashInstalledActionsVisibility, Mode=OneWay}"
                                                                         IsEnabled="{x:Bind ViewModel.CanUseInstalledGitBash, Mode=OneWay}"
                                                                         Click="OnCopyGitBashPathClick"
                                                                         ToolTipService.ToolTip="{x:Bind ViewModel.GitCopyPathToolTip, Mode=OneWay}"
                                                                         AutomationProperties.Name="Copy Git installation path">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </controls:StableCursorButton>
                                        </Grid>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:StableHyperlinkButton
                                                Content="{x:Bind ViewModel.GitBashPrimaryActionText, Mode=OneWay}"
                                                Style="{StaticResource RuntimeOperationButtonStyle}"
                                                Visibility="{x:Bind ViewModel.GitBashPrimaryActionVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanRunGitBashAction, Mode=OneWay}"
                                                Click="OnInstallOrUpgradeGitBashClick" />
                                            <controls:StableHyperlinkButton
                                                Content="{x:Bind ViewModel.GitBashUninstallText, Mode=OneWay}"
                                                Style="{StaticResource RuntimeOperationButtonStyle}"
                                                Visibility="{x:Bind ViewModel.GitBashInstalledActionsVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanUseInstalledGitBash, Mode=OneWay}"
                                                Click="OnUninstallGitBashClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0"
                                            Visibility="{x:Bind ViewModel.GitBashInstalledActionsVisibility, Mode=OneWay}">
                                    <controls:StableCursorButton Content="{x:Bind ViewModel.GitBashLaunchText, Mode=OneWay}"
                                                                 IsEnabled="{x:Bind ViewModel.CanUseInstalledGitBash, Mode=OneWay}"
                                                                 Click="OnLaunchGitBashClick" MinWidth="132" />
                                    <controls:StableCursorButton Content="{x:Bind ViewModel.GitBashLaunchAsAdministratorText, Mode=OneWay}"
                                                                 IsEnabled="{x:Bind ViewModel.CanUseInstalledGitBash, Mode=OneWay}"
                                                                 Click="OnLaunchGitBashAsAdministratorClick" MinWidth="180" />
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="12,0"
                                            Visibility="{x:Bind ViewModel.GitBashOperationVisibility, Mode=OneWay}">
                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{x:Bind ViewModel.GitBashOperationPercentage, Mode=OneWay}"
                                                 IsIndeterminate="False"
                                                 Visibility="{x:Bind ViewModel.GitBashProgressVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.GitBashOperationText, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}" />
                                </StackPanel>
                                <InfoBar IsOpen="True" Severity="Error" Margin="12,0"
                                         Visibility="{x:Bind ViewModel.GitBashProblemVisibility, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.GitBashProblemText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{x:Bind ViewModel.GitBashConfigurationTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.GitUserNameLabel, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.GitUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind ViewModel.GitUserNamePlaceholder, Mode=OneWay}"
                                             IsEnabled="{x:Bind ViewModel.CanEditGitConfiguration, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.GitUserEmailLabel, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.GitUserEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind ViewModel.GitUserEmailPlaceholder, Mode=OneWay}"
                                             IsEnabled="{x:Bind ViewModel.CanEditGitConfiguration, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.GitConfigurationScopeText, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <controls:StableCursorButton Grid.Column="1"
                                                                 Content="{x:Bind ViewModel.GitConfigurationSaveText, Mode=OneWay}"
                                                                 IsEnabled="{x:Bind ViewModel.CanEditGitConfiguration, Mode=OneWay}"
                                                                 Click="OnSaveGitConfigurationClick" MinWidth="112" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="8,8,8,16"
                                Visibility="{x:Bind ViewModel.GitEnvironmentChecksVisibility, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.GitEnvironmentTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Margin="12,4" />
                                <ListView ItemsSource="{x:Bind ViewModel.GitEnvironmentChecks}"
                                          SelectionMode="None" HorizontalContentAlignment="Stretch"
                                          ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}"
                                          AutomationProperties.Name="Git component checks">
                                    <ListView.Header>
                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="8" Height="48">
                                            <Grid Padding="20,0" ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ViewModel.GitCheckItemHeader, Mode=OneWay}"
                                                           Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GitCheckStatusHeader, Mode=OneWay}"
                                                           Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.GitCheckResultHeader, Mode=OneWay}"
                                                           Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid Padding="20,12" ColumnSpacing="20" MinHeight="54">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" BorderBrush="{Binding StatusBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="10,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                                   FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Result}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{Binding Result}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ToolboxView" Visibility="Collapsed" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="208" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource SoftPilotCardBackground}"
                            CornerRadius="12" Padding="10">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <controls:StableCursorToggleButton x:Name="JsonToolButton" IsChecked="True"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Padding="12" Click="OnJsonToolClick">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE943;" FontSize="18" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.JsonFormatterText, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StableCursorToggleButton>
                                <controls:StableCursorToggleButton x:Name="EnvironmentToolButton"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Padding="12" Click="OnEnvironmentToolClick">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EnvironmentVariablesText, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StableCursorToggleButton>
                                <controls:StableCursorToggleButton x:Name="HostsToolButton"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Padding="12" Click="OnHostsToolClick">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE774;" FontSize="18" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HostsText, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StableCursorToggleButton>
                            </StackPanel>

                            <Grid x:Name="JsonHistoryPanel" Grid.Row="1" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="10,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.JsonHistoryText, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               VerticalAlignment="Center" />
                                    <controls:StableCursorButton Grid.Column="1" Width="30" Height="30" Padding="0"
                                            Click="OnClearJsonHistoryClick"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.JsonHistoryClearText, Mode=OneWay}"
                                            AutomationProperties.Name="Clear JSON history">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </controls:StableCursorButton>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="JsonHistoryEmptyText"
                                               Text="{x:Bind ViewModel.JsonHistoryEmptyText, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,20,0,0" />
                                    <ListView x:Name="JsonHistoryList"
                                              ItemsSource="{x:Bind ViewModel.JsonFormatterHistory}"
                                              SelectionMode="Single"
                                              SelectionChanged="OnJsonHistorySelectionChanged"
                                              ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}"
                                              AutomationProperties.Name="JSON history">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8" ColumnSpacing="4" MinHeight="52">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding UpdatedAtText}" FontSize="11"
                                                                   Foreground="{ThemeResource SoftPilotSubtleText}" />
                                                    </StackPanel>
                                                    <controls:StableCursorButton Grid.Column="1" Width="28" Height="28" Padding="0"
                                                            Click="OnRenameJsonHistoryClick">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </controls:StableCursorButton>
                                                    <controls:StableCursorButton Grid.Column="2" Width="28" Height="28" Padding="0"
                                                            Click="OnDeleteJsonHistoryClick">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </controls:StableCursorButton>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Border x:Name="JsonFormatterPanel" Background="{ThemeResource SoftPilotCardBackground}"
                                CornerRadius="12" Padding="20">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{x:Bind ViewModel.JsonFormatterText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <controls:StableCursorToggleButton x:Name="JsonBeautifyButton"
                                                  Content="{x:Bind ViewModel.JsonBeautifyText, Mode=OneWay}"
                                                  IsChecked="True" Click="OnJsonBeautifyClick" />
                                    <controls:StableCursorToggleButton x:Name="JsonMinifyButton"
                                                  Content="{x:Bind ViewModel.JsonMinifyText, Mode=OneWay}"
                                                  Click="OnJsonMinifyClick" />
                                    <controls:StableCursorButton Content="{x:Bind ViewModel.JsonClearText, Mode=OneWay}"
                                            Click="OnJsonClearClick" />
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnSpacing="12" MinHeight="320">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.JsonInputText, Mode=OneWay}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBox x:Name="JsonInputTextBox" Grid.Row="1"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                                 Padding="14" VerticalContentAlignment="Top"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 PlaceholderText="{x:Bind ViewModel.JsonInputPlaceholderText, Mode=OneWay}"
                                                 TextChanged="OnJsonInputTextChanged"
                                                 AutomationProperties.Name="JSON input" />
                                    </Grid>

                                    <Grid Grid.Column="1" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ViewModel.JsonOutputText, Mode=OneWay}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <controls:StableCursorButton x:Name="JsonCopyButton" Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="32" Height="32" IsEnabled="False"
                                                    Click="OnJsonCopyClick"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.JsonCopyText, Mode=OneWay}"
                                                    AutomationProperties.Name="Copy JSON result">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </controls:StableCursorButton>
                                        </Grid>
                                        <TextBox x:Name="JsonOutputTextBox" Grid.Row="1"
                                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                                 Padding="14" VerticalContentAlignment="Top"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 PlaceholderText="{x:Bind ViewModel.JsonOutputPlaceholderText, Mode=OneWay}"
                                                 AutomationProperties.Name="JSON result" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="EnvironmentVariablesPanel" Visibility="Collapsed"
                                Background="{ThemeResource SoftPilotCardBackground}"
                                CornerRadius="12" Padding="20">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.EnvironmentVariablesText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:StableCursorToggleButton x:Name="UserEnvironmentButton" IsChecked="True"
                                                  Content="{x:Bind ViewModel.EnvironmentUserScopeText, Mode=OneWay}"
                                                  Click="OnUserEnvironmentScopeClick" />
                                    <controls:StableCursorToggleButton x:Name="MachineEnvironmentButton" Grid.Column="1"
                                                  Content="{x:Bind ViewModel.EnvironmentMachineScopeText, Mode=OneWay}"
                                                  Click="OnMachineEnvironmentScopeClick" />
                                    <controls:StableCursorButton Grid.Column="2"
                                                                 Style="{StaticResource IconButtonStyle}"
                                                                 Width="32" Height="32"
                                                                 Click="OnOpenSystemEnvironmentVariablesClick"
                                                                 ToolTipService.ToolTip="{x:Bind ViewModel.OpenSystemEnvironmentVariablesText, Mode=OneWay}"
                                                                 AutomationProperties.Name="Open Windows environment variables">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    </controls:StableCursorButton>
                                    <controls:StableCursorButton Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                                                 Width="32" Height="32"
                                                                 Click="OnRefreshEnvironmentVariablesClick"
                                                                 ToolTipService.ToolTip="{x:Bind ViewModel.RefreshText, Mode=OneWay}"
                                                                 AutomationProperties.Name="Refresh environment variables">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </controls:StableCursorButton>
                                    <controls:StableCursorButton Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                                                 Width="32" Height="32"
                                                                 Click="OnAddEnvironmentVariableClick"
                                                                 ToolTipService.ToolTip="{x:Bind ViewModel.EnvironmentAddText, Mode=OneWay}"
                                                                 AutomationProperties.Name="Add environment variable">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    </controls:StableCursorButton>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <TextBlock x:Name="EnvironmentVariablesEmptyText"
                                               Text="{x:Bind ViewModel.EnvironmentEmptyText, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ListView x:Name="EnvironmentVariablesList"
                                              ItemsSource="{x:Bind ViewModel.EnvironmentVariables}"
                                              SelectionMode="None"
                                              ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}">
                                        <ListView.Header>
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8" Height="44">
                                                <Grid Padding="14,0" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="108" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind ViewModel.EnvironmentNameHeaderText, Mode=OneWay}"
                                                               Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EnvironmentValueHeaderText, Mode=OneWay}"
                                                               Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                                </Grid>
                                            </Border>
                                        </ListView.Header>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,9" ColumnSpacing="12" MinHeight="48">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding Name}" />
                                                    <controls:StableCursorButton Grid.Column="1"
                                                                                 Style="{StaticResource CellValueButtonStyle}"
                                                                                 Tag="EnvironmentValue"
                                                                                 Click="OnEditEnvironmentVariableClick"
                                                                                 ToolTipService.ToolTip="{Binding ExpandedValue}">
                                                        <TextBlock Text="{Binding ExpandedValue}"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    </controls:StableCursorButton>
                                                    <controls:StableCursorButton Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                                                                 Width="32" Height="32" Tag="EnvironmentSave"
                                                                                 Visibility="Collapsed"
                                                                                 Click="OnSaveEnvironmentVariableInlineClick"
                                                                                 ToolTipService.ToolTip="Save">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                                    </controls:StableCursorButton>
                                                    <controls:StableCursorButton Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                                                 Width="32" Height="32" Tag="EnvironmentCancel"
                                                                                 Visibility="Collapsed"
                                                                                 Click="OnCancelEnvironmentVariableInlineClick"
                                                                                 ToolTipService.ToolTip="Cancel">
                                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                                    </controls:StableCursorButton>
                                                    <controls:StableCursorButton Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                                                                 Width="32" Height="32" Tag="EnvironmentDelete"
                                                                                 Click="OnDeleteEnvironmentVariableClick"
                                                                                 ToolTipService.ToolTip="Delete">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="Firebrick" />
                                                    </controls:StableCursorButton>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="HostsPanel" Visibility="Collapsed"
                                Background="{ThemeResource SoftPilotCardBackground}"
                                CornerRadius="12" Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.HostsText, Mode=OneWay}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <controls:StableCursorButton Grid.Column="1" Margin="0,0,4,0"
                                                                 Style="{StaticResource IconButtonStyle}"
                                                                 Width="32" Height="32"
                                                                 Click="OnReloadHostsClick"
                                                                 ToolTipService.ToolTip="{x:Bind ViewModel.HostsReloadText, Mode=OneWay}"
                                                                 AutomationProperties.Name="Reload Hosts">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </controls:StableCursorButton>
                                    <controls:StableCursorButton x:Name="HostsSaveButton" Grid.Column="2"
                                                                 Style="{StaticResource IconButtonStyle}"
                                                                 Width="32" Height="32"
                                                                 Click="OnSaveHostsClick"
                                                                 ToolTipService.ToolTip="{x:Bind ViewModel.HostsSaveText, Mode=OneWay}"
                                                                 AutomationProperties.Name="Save Hosts">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    </controls:StableCursorButton>
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.HostsPathText, Mode=OneWay}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HostsPath, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.HostsPath, Mode=OneWay}" />
                                </Grid>
                                <TextBox x:Name="HostsEditorTextBox" Grid.Row="2"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                         Padding="14" VerticalContentAlignment="Top"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         KeyDown="OnHostsEditorKeyDown"
                                         AutomationProperties.Name="Hosts editor" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="TasksView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="8,8,8,16"
                            HorizontalAlignment="Stretch">
                        <ListView ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None" MinHeight="240"
                                  HorizontalContentAlignment="Stretch"
                                  ItemContainerStyle="{StaticResource RuntimeTableListItemStyle}"
                                  AutomationProperties.Name="Task history">
                                <ListView.Header>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8" Height="48">
                                        <Grid Padding="16,0" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ViewModel.TimeHeaderText, Mode=OneWay}"
                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusHeaderText, Mode=OneWay}"
                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TaskTypeHeaderText, Mode=OneWay}"
                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.TargetHeaderText, Mode=OneWay}"
                                                       Style="{StaticResource RuntimeTableHeaderTextStyle}" />
                                        </Grid>
                                    </Border>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="16,12" ColumnSpacing="16" MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StartedAt}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{Binding NameBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Target}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{x:Bind ViewModel.ModulesText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <GridView ItemsSource="{x:Bind ViewModel.ModuleSettings}"
                                          SelectionMode="None"
                                          CanDragItems="True"
                                          CanReorderItems="True"
                                          AllowDrop="True"
                                          ReorderMode="Enabled"
                                          DragItemsCompleted="OnModuleItemsDragCompleted"
                                          ItemContainerStyle="{StaticResource ModuleCardItemStyle}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Runtime module order">
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="168" Height="148" Padding="16"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE700;" FontSize="12" Opacity="0.45"
                                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <StackPanel Spacing="10" HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Image Source="{Binding IconPath}" Width="36" Height="36"
                                                               Stretch="Uniform"
                                                               AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  MinWidth="0" Padding="0"
                                                                  AutomationProperties.Name="{Binding DisplayName}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.ModuleAutoSaveText, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ModuleSaveStatusText, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.ModuleSaveStatusBrush, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.LanguageText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                                          DisplayMemberPath="DisplayName" MinWidth="220" MinHeight="44"
                                          HorizontalAlignment="Left" SelectionChanged="OnLanguageSelectionChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <InfoBar x:Name="TransientNotificationBar" Grid.RowSpan="2"
                     IsOpen="False" IsClosable="False"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     MaxWidth="420" Margin="0,8,8,0"
                     Canvas.ZIndex="10" />
        </Grid>
    </NavigationView>
</Window>
