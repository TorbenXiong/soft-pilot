<Window
    x:Class="SoftPilot.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SoftPilot">

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="开发运行时" />
            <NavigationViewItem x:Name="NodeNavigationItem" Content="Node.js" Tag="runtime:node"
                                Visibility="{x:Bind ViewModel.NodeModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Node.js 模块">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="JavaNavigationItem" Content="Java" Tag="runtime:java"
                                Visibility="{x:Bind ViewModel.JavaModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Java 模块">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PythonNavigationItem" Content="Python" Tag="runtime:python"
                                Visibility="{x:Bind ViewModel.PythonModuleVisibility, Mode=OneWay}"
                                AutomationProperties.Name="Python 模块">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="TasksNavigationItem" Content="任务历史" Tag="tasks"
                                AutomationProperties.Name="任务历史">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="设置" Tag="settings"
                                AutomationProperties.Name="设置">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Node.js" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageSubtitle" Text="管理 Node.js 的安装版本与全局切换。" Margin="0,6,0,0"
                               Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}" MinWidth="96" MinHeight="40"
                        AutomationProperties.Name="刷新当前状态">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar Grid.Row="1" Margin="0,0,0,16" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" IsClosable="False" />

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="RuntimesView"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{x:Bind ViewModel.RuntimeDisplayName, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.RuntimeInstallDescription, Mode=OneWay}"
                                           Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="推荐版本" />
                                    <ComboBox Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.RecommendedVersions}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRecommendedVersion, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalContentAlignment="Stretch"
                                              MinHeight="40" AutomationProperties.Name="官方推荐版本" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="安装" Command="{x:Bind ViewModel.InstallCommand}"
                                            Style="{StaticResource AccentButtonStyle}" MinWidth="112" MinHeight="40" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                               Text="{x:Bind ViewModel.RecommendedVersionHint, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                </Grid>
                                <CheckBox Content="安装后设为全局版本"
                                          IsChecked="{x:Bind ViewModel.MakeCurrentAfterInstall, Mode=TwoWay}" />
                                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                             Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                                             AutomationProperties.Name="当前操作进度" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="已管理版本" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="卸载会先移入回收站，七日内可恢复。当前全局版本不能卸载。"
                                                   Foreground="{ThemeResource SoftPilotSubtleText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="设为全局" Command="{x:Bind ViewModel.UseSelectedCommand}" MinHeight="40" />
                                        <Button Content="卸载" Command="{x:Bind ViewModel.UninstallSelectedCommand}" MinHeight="40" />
                                        <Button Content="恢复" Command="{x:Bind ViewModel.RestoreSelectedCommand}" MinHeight="40" />
                                    </StackPanel>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.ManagedRuntimes}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRuntime, Mode=TwoWay}"
                                          SelectionMode="Single" MinHeight="160" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="当前模块的 SoftPilot 管理版本">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Version}" FontFamily="Cascadia Mono,Consolas" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding State}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="外部发现（只读）" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="SoftPilot 不会修改或卸载 PATH、注册表和 Program Files 中发现的外部运行时。"
                                           Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{x:Bind ViewModel.ExternalRuntimes}" SelectionMode="None"
                                          MinHeight="100" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="当前模块的外部只读运行时">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Version}" FontFamily="Cascadia Mono,Consolas" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TasksView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <TextBlock Text="最近任务" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ListView ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None" MinHeight="240"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="最近任务">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StartedAt}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Target}" FontFamily="Cascadia Mono,Consolas" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="模块" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="选择左侧要显示的运行时模块。隐藏模块不会卸载已有版本，也不影响 CLI 使用。"
                                           Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                <ToggleSwitch Header="Node.js" OnContent="显示" OffContent="隐藏"
                                              IsOn="{x:Bind ViewModel.NodeModuleEnabled, Mode=TwoWay}"
                                              MinHeight="48" AutomationProperties.Name="显示 Node.js 模块" />
                                <ToggleSwitch Header="Java · Eclipse Temurin" OnContent="显示" OffContent="隐藏"
                                              IsOn="{x:Bind ViewModel.JavaModuleEnabled, Mode=TwoWay}"
                                              MinHeight="48" AutomationProperties.Name="显示 Java 模块" />
                                <ToggleSwitch Header="Python · CPython" OnContent="显示" OffContent="隐藏"
                                              IsOn="{x:Bind ViewModel.PythonModuleEnabled, Mode=TwoWay}"
                                              MinHeight="48" AutomationProperties.Name="显示 Python 模块" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.EnabledModuleSummary, Mode=OneWay}"
                                               Foreground="{ThemeResource SoftPilotSubtleText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="保存模块配置"
                                            Command="{x:Bind ViewModel.SaveModulePreferencesCommand}"
                                            Style="{StaticResource AccentButtonStyle}" MinHeight="40" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Text="工作区" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="V1 不支持安装后迁移。该路径由安装器和 HKCU 共同维护。"
                                           Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                <TextBox Header="SoftPilot Root" Text="{x:Bind ViewModel.RootPath}" IsReadOnly="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SoftPilotCardBackground}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Shell 集成" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="显式启用后，shims 会放在用户 PATH 前部，并保存原 PATH 与 JAVA_HOME。"
                                           Foreground="{ThemeResource SoftPilotSubtleText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ShellStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="启用/修复" Command="{x:Bind ViewModel.EnableShellCommand}"
                                            Style="{StaticResource AccentButtonStyle}" MinHeight="40" />
                                    <Button Content="禁用并恢复" Command="{x:Bind ViewModel.DisableShellCommand}" MinHeight="40" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
