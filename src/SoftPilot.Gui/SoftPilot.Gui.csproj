<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SoftPilot</AssemblyName>
    <RootNamespace>SoftPilot.Gui</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SoftPilot.Application/SoftPilot.Application.csproj" />
    <ProjectReference Include="../SoftPilot.Domain/SoftPilot.Domain.csproj" />
    <ProjectReference Include="../SoftPilot.Infrastructure/SoftPilot.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\RuntimeIcons\*.*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(PortableToolsArchive)"
                      LogicalName="SoftPilot.Gui.PortableTools.zip"
                      Condition="'$(PortableToolsArchive)' != ''" />
  </ItemGroup>
  <Target Name="CopyWinUiGeneratedResourcesToPublish"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_WinUiGeneratedResource Include="$(TargetDir)*.xbf" />
      <_WinUiGeneratedResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="'@(_WinUiGeneratedResource)' == ''"
           Text="WinUI generated XBF/PRI resources were not found in $(TargetDir)." />
    <Copy SourceFiles="@(_WinUiGeneratedResource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="InvalidateWinUiSingleFileManifest"
          AfterTargets="GetNewAppManifestValues"
          BeforeTargets="CreateWinRTRegistration"
          Condition="'$(PublishSingleFile)' == 'true'">
    <Delete Files="$(ApplicationManifest)" />
  </Target>
</Project>
