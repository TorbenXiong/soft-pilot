<Window x:Class="SoftPilot.Uninstall.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 SoftPilot" Width="560" Height="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="卸载 SoftPilot" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="默认只移除 SoftPilot 程序文件，并保留已安装运行时、状态、缓存、回收站和日志。Shell 环境将恢复到启用前的快照。" />
        </StackPanel>
        <CheckBox x:Name="DeleteWorkspaceBox" Grid.Row="1" Margin="0,28,0,0"
                  VerticalAlignment="Top"
                  Content="同时删除整个 SoftPilot 工作区（不可恢复）" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="96" Height="38" Margin="0,0,12,0" Content="取消" Click="OnCancel" />
            <Button Width="112" Height="38" Content="卸载" Click="OnUninstall" />
        </StackPanel>
    </Grid>
</Window>
